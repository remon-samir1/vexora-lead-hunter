NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GOOGLE_PLACES_API_KEY=
# Enable only after explicit budget approval and configured database limits.
GOOGLE_REQUESTS_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
